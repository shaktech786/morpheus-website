# Supabase (same project as Morpheus backend: hdcgbbmjbkbwlluobkqe)
SUPABASE_URL=https://hdcgbbmjbkbwlluobkqe.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Resend (https://resend.com — free tier: 3,000 emails/month)
RESEND_API_KEY=

# GitHub issue submission (POST /api/report-issue → creates issue in this repo)
# Use a fine-grained PAT scoped to "Issues: Read and write" on shaktech786/morpheus only.
GITHUB_ISSUE_TOKEN=
GITHUB_ISSUE_REPO=shaktech786/morpheus

# Required Supabase Storage bucket: "issue-screenshots" (public, used to host images
# embedded in GitHub issue bodies). Create via Supabase dashboard or:
#   supabase storage create issue-screenshots --public
